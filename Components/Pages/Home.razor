@page "/"
@using TodoApp.Models
@using TodoApp.Services
@inject TodoService TodoService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Todo App</PageTitle>

<div class="todo-page">
    <header class="todo-header">
        <h1>ToDo App</h1>
    </header>
    <p style="color: white;">
        Einträge in MariaDB:
        @(databaseCount?.ToString() ?? "Wird geladen …")
    </p>
    <div class="todo-create">
        <div class="todo-create-input">
            <label>New Todo:</label>
            <input type="text"
            placeholder="Todo Title"
            @bind="newTitle"
            @bind:event="oninput" />
        </div>

        <div class="todo-add-button">
            <button @onclick="AddTodo">Add ToDo</button>
        </div>
    </div>
    

    <div class="todo-controls">
        <div class="todo-status">
            <div>
                <label>Status:</label> @* Filter todos by status *@
                <select @bind="selectedStatus"
                @bind:after="SaveSelectionAsync">
                    <option value="">All</option>
                    <option value="@TodoStatus.Open">Open</option>
                    <option value="@TodoStatus.InProgress">In Progress</option>
                    <option value="@TodoStatus.Done">Done</option>
                </select>
            </div>
        </div>
        <div class="todo-sort">
            <div>
                <label>Sort:</label> @* Sort todos *@
                <select @bind="selectedSort"
                @bind:after="SaveSelectionAsync">
                    <option value="@TodoSort.Deadline">Date Deadline</option>
                    <option value="@TodoSort.Title">Title</option>
                    <option value="@TodoSort.Status">Status</option>
                </select>
            </div>
        </div>
    </div>
        <p style="color: white;">
    Statusfilter: @(selectedStatus?.ToString() ?? "All")
    | Sortierung: @selectedSort
        </p>

    <div class="todo-list">
        @foreach (TodoItem todo in todos)
        {
            <div class="todo-item" @key="todo.Id">
                <div class="todo-check">    
                    <input type="checkbox"/>
                    <span>@todo.Title</span>
                </div>

                <div class="todo-details">
                    <button @onclick="() => OpenTodo(todo.Id)">Open</button>
                </div>
            </div>
        }
    </div>
       
</div>

@code {
    // Code-behind for the Home page, handling the creation of new todos and interaction with the TodoService.
    private void EditTodo(int todoId)
    {
        Navigation.NavigateTo($"/details/edit/{todoId}");
    }
    private string newTitle =""; // Holds the title of the new todo item being created.
    private void AddTodo() { // Adds a new todo item using the TodoService.
        if (string.IsNullOrWhiteSpace(newTitle)) { // Prevent adding empty todos.
            return;
        }

        string title = Uri.EscapeDataString(newTitle.Trim());
        Navigation.NavigateTo($"/details/edit?title={title}");
    }

    private void OpenTodo(int todoId)
    {
        Navigation.NavigateTo($"/details/{todoId}");
    }

    private TodoStatus? selectedStatus = null;
    private TodoSort selectedSort = TodoSort.Deadline;
    private int? databaseCount;

    private List<TodoItem> todos = new();
    private async Task LoadTodoAsync()
    {
        todos = await TodoService.GetTodosAsync(
            selectedStatus,
            selectedSort);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        string? savedStatus = await JS.InvokeAsync<string?>(
            "localStorage.getItem", "todo.sort");
        string? savedSort = await JS.InvokeAsync<string?>(
            "localStorage.getItem", "todo.sort");

        if (Enum.TryParse<TodoStatus>(savedStatus, out var status)
            && Enum.IsDefined(status))
        {
            selectedStatus = status;
        }

        if (Enum.TryParse<TodoSort>(savedSort, out var sort)
            && Enum.IsDefined(sort))
        {
            selectedSort = sort;
        }

        databaseCount = await TodoService.CountAsync();
        await LoadTodoAsync();

        StateHasChanged();
    }
    private async Task SaveSelectionAsync()
    {
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "todo.statusFilster",
            selectedStatus?.ToString() ?? "");

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "todo.sort",
            selectedSort.ToString());
        await LoadTodoAsync();
    }
    
}